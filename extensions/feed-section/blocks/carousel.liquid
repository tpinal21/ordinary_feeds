{{ 'carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'embla-carousel-auto-scroll.umd.js' | asset_url }}" defer></script>
<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{%- liquid
  # The merchant types a feed label from the app (e.g. CAROUSEL_HP_01) in the
  # block settings; its gallery reference resolves straight to the posts.
  # `$app:feed` isn't accepted in Liquid lookups, hence the full type name.
  # Liquid only exposes the first 50 entries, far more feeds than a shop has.
  assign feed_label = block.settings.feed | strip | upcase
  assign feed = nil
  assign wrong_page_feed = nil

  # The feed page this template serves. A feed only renders on its own page
  # type — a home page feed never shows on a product page, and so on.
  case template.name
    when 'index'
      assign feed_page = 'HOME_PAGE'
      assign default_label = 'CAROUSEL_HP_01'
    when 'product'
      assign feed_page = 'PRODUCT_PAGE'
      assign default_label = 'CAROUSEL_PP_01'
    when 'collection'
      assign feed_page = 'COLLECTION_PAGE'
      assign default_label = 'CAROUSEL_CP_01'
  endcase

  # Left empty: this page's first carousel feed. Labels are generated as
  # <TYPE>_<PAGE>_<NN> (app/routes/api.feeds.jsx), so it's `_01` for the page.
  if feed_label == blank
    assign feed_label = default_label
  endif

  # Documented global is `metaobjects`, not `shop.metaobjects`.
  assign feed_entries = metaobjects['app--393150267393--feed'].values

  if feed_label != blank
    for candidate in feed_entries
      # Handle match: blocks saved while this setting was a metaobject picker
      # still hold the feed's handle instead of its label.
      assign candidate_handle = candidate.system.handle | upcase
      if candidate.label.value == feed_label or candidate_handle == feed_label
        if candidate.page.value == feed_page
          assign feed = candidate
        else
          assign wrong_page_feed = candidate
        endif
        break
      endif
    endfor
  endif

  assign posts = feed.gallery.value.posts.value

  # Per-feed settings. Fallbacks mirror CAROUSEL_FEED_DEFAULTS in
  # app/lib/feeds.js; `allow_false` keeps a stored `false` from being swapped
  # for the default.
  assign carousel = feed.settings.value
  assign cs_loop = carousel.loop | default: true, allow_false: true
  assign cs_auto_scroll = carousel.auto_scroll | default: false, allow_false: true
  assign cs_media_auto_play = carousel.media_auto_play | default: false, allow_false: true
  assign cs_per_view = carousel.slides_per_view | default: 7
  assign cs_speed = carousel.speed | default: 1
  assign cs_gap = carousel.item_gap | default: 8, allow_false: true
  assign cs_radius = carousel.border_radius | default: 8, allow_false: true

  # App-wide settings (the Settings page).
  assign app_settings = shop.metafields["$app"].settings.value
-%}

{% if feed == blank or posts == blank or posts.size == 0 %}
  {% if request.design_mode %}
    <p class="insta-carousel__placeholder" {{ block.shopify_attributes }}>
      {% if feed_page == blank %}
        Feeds can only be added to the home, product and collection pages.
      {% elsif wrong_page_feed %}
        {{ wrong_page_feed.label.value }} is a
        {{ wrong_page_feed.page.value | replace: '_', ' ' | downcase }} feed and
        can't be used on this page. Use a feed created for this page in the app.
      {% elsif feed == blank %}
        {% if feed_entries.size > 0 %}
          {%- liquid
            assign page_labels = ''
            for candidate in feed_entries
              if candidate.page.value == feed_page
                assign page_labels = page_labels | append: candidate.label.value | append: ', '
              endif
            endfor
            assign page_labels = page_labels | remove_last: ', '
          -%}
          No feed called "{{ feed_label }}" for this page. Check the label in
          the app.
          {% if page_labels != blank %}(Feeds for this page: {{ page_labels }}){% endif %}
        {% else %}
          No feeds available to this block. The app's feeds aren't readable
          here yet (check the feed metaobject type and its storefront access).
        {% endif %}
      {% else %}
        The selected feed has no posts yet.
      {% endif %}
    </p>
  {% endif %}
{% elsif app_settings.storefront_enabled != false %}
  <div
    id="insta-carousel"
    class="insta-carousel"
    role="region"
    aria-roledescription="carousel"
    tabindex="0"
    data-insta-carousel
    data-loop="{{ cs_loop }}"
    data-auto-scroll="{{ cs_auto_scroll }}"
    data-speed="{{ cs_speed }}"
    data-media-auto-play="{{ cs_media_auto_play }}"
    style="--insta-per-view: {{ cs_per_view }};--insta-gap: {{ cs_gap }}px;--insta-radius: {{ cs_radius }}px"
    {{ block.shopify_attributes }}
  >
    <div class="insta-carousel__viewport">
      <div class="insta-carousel__container">
        {% for post in posts %}
          {%- liquid
            assign media_url = post.media_url.value
            assign poster = post.thumbnail_url.value | default: media_url
            assign alt_text = post.caption.value | default: 'Instagram post' | strip_html | truncate: 80
          -%}
          <div class="insta-carousel__slide" role="group" aria-roledescription="slide" data-insta-card>
            <div class="insta-carousel__media">
              <video
                class="insta-carousel__video"
                data-insta-video
                src="{{ media_url }}"
                poster="{{ poster }}"
                aria-label="{{ alt_text | escape }}"
                muted
                loop
                playsinline
                preload="none"
              ></video>

              <div class="insta-carousel__progress"><div class="insta-carousel__progress-bar" data-insta-progress></div></div>

              <button type="button" class="insta-carousel__mute" data-insta-mute aria-label="Unmute video">
                <svg class="insta-carousel__icon insta-carousel__icon--muted" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M12 4L9.91 6.09L12 8.18M4.27 3L3 4.27L7.73 9H3v6h4l5 5v-6.73l4.25 4.26c-.67.51-1.42.93-2.25 1.17v2.07c1.38-.32 2.63-.95 3.68-1.81L19.73 21L21 19.73l-9-9M19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.9 8.9 0 0 0 21 12c0-4.28-3-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71m-2.5 0c0-1.77-1-3.29-2.5-4.03v2.21l2.45 2.45c.05-.2.05-.42.05-.63"/>
                </svg>
                <svg class="insta-carousel__icon insta-carousel__icon--unmuted" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M3 9h4l5-5v16l-5-5H3V9zm18 3a9.003 9.003 0 0 1-7 8.777V18.71a7.003 7.003 0 0 0 0-13.42V3.223c4.008.91 7 4.494 7 8.777zm-4 0a5.001 5.001 0 0 1-3 4.584V7.416c1.766.772 3 2.534 3 4.584z"/>
                </svg>
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Same as the app: auto-scrolling feeds have no arrows. {%- endcomment -%}
    {% unless cs_auto_scroll %}
    <button type="button" class="insta-carousel__btn insta-carousel__btn--prev" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span class="insta-carousel__sr">Previous slide</span>
    </button>
    <button type="button" class="insta-carousel__btn insta-carousel__btn--next" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"/>
      </svg>
      <span class="insta-carousel__sr">Next slide</span>
    </button>
    {% endunless %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Insta Carousel",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "feed",
      "label": "Feed label",
      "placeholder": "Auto: this page's first feed",
      "info": "Leave empty to show this page's first carousel feed (CAROUSEL_HP_01 on the home page, CAROUSEL_PP_01 on product pages, CAROUSEL_CP_01 on collection pages). Or paste any feed label from the app."
    }
  ]
}
{% endschema %}
