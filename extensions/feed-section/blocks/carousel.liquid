{{ 'carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'embla-carousel-auto-scroll.umd.js' | asset_url }}" defer></script>
<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{%- liquid
  # The merchant picks a `$app:feed` metaobject (synced from the app) in the
  # theme editor; its gallery reference resolves straight to the posts.
  assign feed = block.settings.feed
  assign posts = feed.gallery.value.posts.value

  # Per-feed settings. Fallbacks mirror CAROUSEL_FEED_DEFAULTS in
  # app/lib/feeds.js; `allow_false` keeps a stored `false` from being swapped
  # for the default.
  assign carousel = feed.settings.value
  assign cs_loop = carousel.loop | default: true, allow_false: true
  assign cs_auto_scroll = carousel.auto_scroll | default: false, allow_false: true
  assign cs_media_auto_play = carousel.media_auto_play | default: false, allow_false: true
  assign cs_per_view = carousel.slides_per_view | default: 7
  assign cs_speed = carousel.speed | default: 1
  assign cs_gap = carousel.item_gap | default: 8, allow_false: true
  assign cs_radius = carousel.border_radius | default: 8, allow_false: true

  # App-wide settings (the Settings page).
  assign app_settings = shop.metafields["$app"].settings.value
-%}

{% if feed == blank or posts == blank or posts.size == 0 %}
  {% if request.design_mode %}
    <p class="insta-carousel__placeholder" {{ block.shopify_attributes }}>
      {% if feed == blank %}
        Select a feed in this block's settings.
      {% else %}
        The selected feed has no posts yet.
      {% endif %}
    </p>
  {% endif %}
{% elsif app_settings.storefront_enabled != false %}
  <div
    id="insta-carousel"
    class="insta-carousel"
    role="region"
    aria-roledescription="carousel"
    tabindex="0"
    data-insta-carousel
    data-loop="{{ cs_loop }}"
    data-auto-scroll="{{ cs_auto_scroll }}"
    data-speed="{{ cs_speed }}"
    data-media-auto-play="{{ cs_media_auto_play }}"
    style="--insta-per-view: {{ cs_per_view }};--insta-gap: {{ cs_gap }}px;--insta-radius: {{ cs_radius }}px"
    {{ block.shopify_attributes }}
  >
    <div class="insta-carousel__viewport">
      <div class="insta-carousel__container">
        {% for post in posts %}
          {%- liquid
            assign media_url = post.media_url.value
            assign poster = post.thumbnail_url.value | default: media_url
            assign alt_text = post.caption.value | default: 'Instagram post' | strip_html | truncate: 80
          -%}
          <div class="insta-carousel__slide" role="group" aria-roledescription="slide" data-insta-card>
            <div class="insta-carousel__media">
              <video
                class="insta-carousel__video"
                data-insta-video
                src="{{ media_url }}"
                poster="{{ poster }}"
                aria-label="{{ alt_text | escape }}"
                muted
                loop
                playsinline
                preload="none"
              ></video>

              <div class="insta-carousel__progress"><div class="insta-carousel__progress-bar" data-insta-progress></div></div>

              <button type="button" class="insta-carousel__mute" data-insta-mute aria-label="Unmute video">
                <svg class="insta-carousel__icon insta-carousel__icon--muted" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M12 4L9.91 6.09L12 8.18M4.27 3L3 4.27L7.73 9H3v6h4l5 5v-6.73l4.25 4.26c-.67.51-1.42.93-2.25 1.17v2.07c1.38-.32 2.63-.95 3.68-1.81L19.73 21L21 19.73l-9-9M19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.9 8.9 0 0 0 21 12c0-4.28-3-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71m-2.5 0c0-1.77-1-3.29-2.5-4.03v2.21l2.45 2.45c.05-.2.05-.42.05-.63"/>
                </svg>
                <svg class="insta-carousel__icon insta-carousel__icon--unmuted" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M3 9h4l5-5v16l-5-5H3V9zm18 3a9.003 9.003 0 0 1-7 8.777V18.71a7.003 7.003 0 0 0 0-13.42V3.223c4.008.91 7 4.494 7 8.777zm-4 0a5.001 5.001 0 0 1-3 4.584V7.416c1.766.772 3 2.534 3 4.584z"/>
                </svg>
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Same as the app: auto-scrolling feeds have no arrows. {%- endcomment -%}
    {% unless cs_auto_scroll %}
    <button type="button" class="insta-carousel__btn insta-carousel__btn--prev" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span class="insta-carousel__sr">Previous slide</span>
    </button>
    <button type="button" class="insta-carousel__btn insta-carousel__btn--next" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"/>
      </svg>
      <span class="insta-carousel__sr">Next slide</span>
    </button>
    {% endunless %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Insta Carousel",
  "target": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "feed",
      "label": "Feed",
      "metaobject_type": "app--393150267393--feed",
      "info": "Feeds are created and edited in the app."
    }
  ]
}
{% endschema %}
