{{ 'carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script src="{{ 'embla-carousel-auto-scroll.umd.js' | asset_url }}" defer></script>
<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{%- liquid
  # The merchant types a feed label from the app (e.g. CAROUSEL_HP_01) in the
  # block settings; its gallery reference resolves straight to the posts.
  # `$app:feed` isn't accepted in Liquid lookups, hence the full type name.
  # Liquid only exposes the first 50 entries, far more feeds than a shop has.
  assign feed_label = block.settings.feed | strip | upcase
  assign feed = nil
  assign wrong_page_feed = nil

  # The feed page this template serves. A feed only renders on its own page
  # type — a home page feed never shows on a product page, and so on.
  case template.name
    when 'index'
      assign feed_page = 'HOME_PAGE'
      assign default_label = 'CAROUSEL_HP_01'
    when 'product'
      assign feed_page = 'PRODUCT_PAGE'
      assign default_label = 'CAROUSEL_PP_01'
    when 'collection'
      assign feed_page = 'COLLECTION_PAGE'
      assign default_label = 'CAROUSEL_CP_01'
  endcase

  # Left empty: this page's first carousel feed. Labels are generated as
  # <TYPE>_<PAGE>_<NN> (app/routes/api.feeds.jsx), so it's `_01` for the page.
  if feed_label == blank
    assign feed_label = default_label
  endif

  # Documented global is `metaobjects`, not `shop.metaobjects`.
  assign feed_entries = metaobjects['app--393150267393--feed'].values

  if feed_label != blank
    for candidate in feed_entries
      # Handle match: blocks saved while this setting was a metaobject picker
      # still hold the feed's handle instead of its label.
      assign candidate_handle = candidate.system.handle | upcase
      if candidate.label.value == feed_label or candidate_handle == feed_label
        if candidate.page.value == feed_page
          assign feed = candidate
        else
          assign wrong_page_feed = candidate
        endif
        break
      endif
    endfor
  endif

  # PRODUCT galleries hold no posts of their own: they show the posts the
  # current product is tagged in, kept on the product by the app
  # (app/lib/product-post-metafields.server.js). Off a product page
  # `product` is nil, so they render nothing.
  assign gallery = feed.gallery.value
  if gallery.type.value == 'PRODUCT'
    assign posts = product.metafields["$app"].instagram_posts.value
  else
    assign posts = gallery.posts.value
  endif
  assign post_limit = gallery.post_limit.value | default: 20

  # Per-feed settings. Fallbacks mirror CAROUSEL_FEED_DEFAULTS in
  # app/lib/feeds.js; `allow_false` keeps a stored `false` from being swapped
  # for the default.
  assign carousel = feed.settings.value
  assign cs_loop = carousel.loop | default: true, allow_false: true
  assign cs_auto_scroll = carousel.auto_scroll | default: false, allow_false: true
  assign cs_media_auto_play = carousel.media_auto_play | default: false, allow_false: true
  assign cs_per_view = carousel.slides_per_view | default: 7
  assign cs_speed = carousel.speed | default: 1
  assign cs_gap = carousel.item_gap | default: 8, allow_false: true
  assign cs_radius = carousel.border_radius | default: 8, allow_false: true
  # Written by the app when the feed is saved; shown in the post dialog.
  assign ig_username = carousel.instagram_username
  assign ig_avatar = carousel.instagram_profile_picture

  # App-wide settings (the Settings page).
  assign app_settings = shop.metafields["$app"].settings.value

  # Settings page → Post clicks: popup | instagram | product | none.
  # Falls back like CLICK_ACTIONS' default in app/lib/app-settings.js.
  assign click_action = app_settings.click.action | default: 'popup'
-%}

{% if feed == blank or posts == blank or posts.size == 0 %}
  {% if request.design_mode %}
    <p class="insta-carousel__placeholder" {{ block.shopify_attributes }}>
      {% if feed_page == blank %}
        Feeds can only be added to the home, product and collection pages.
      {% elsif wrong_page_feed %}
        {{ wrong_page_feed.label.value }} is a
        {{ wrong_page_feed.page.value | replace: '_', ' ' | downcase }} feed and
        can't be used on this page. Use a feed created for this page in the app.
      {% elsif feed == blank %}
        {% if feed_entries.size > 0 %}
          {%- liquid
            assign page_labels = ''
            for candidate in feed_entries
              if candidate.page.value == feed_page
                assign page_labels = page_labels | append: candidate.label.value | append: ', '
              endif
            endfor
            assign page_labels = page_labels | remove_last: ', '
          -%}
          No feed called "{{ feed_label }}" for this page. Check the label in
          the app.
          {% if page_labels != blank %}(Feeds for this page: {{ page_labels }}){% endif %}
        {% else %}
          No feeds available to this block. The app's feeds aren't readable
          here yet (check the feed metaobject type and its storefront access).
        {% endif %}
      {% else %}
        {% if gallery.type.value == 'PRODUCT' %}
          This product isn't tagged in any Instagram post yet. Tag it from
          Manage posts in the app.
        {% else %}
          The selected feed has no posts yet.
        {% endif %}
      {% endif %}
    </p>
  {% endif %}
{% elsif app_settings.storefront_enabled != false %}
  <div
    id="insta-carousel"
    class="insta-carousel"
    role="region"
    aria-roledescription="carousel"
    tabindex="0"
    data-insta-carousel
    data-loop="{{ cs_loop }}"
    data-auto-scroll="{{ cs_auto_scroll }}"
    data-speed="{{ cs_speed }}"
    data-media-auto-play="{{ cs_media_auto_play }}"
    data-click-action="{{ click_action | escape }}"
    style="--insta-per-view: {{ cs_per_view }};--insta-gap: {{ cs_gap }}px;--insta-radius: {{ cs_radius }}px"
    {{ block.shopify_attributes }}
  >
    <div class="insta-carousel__viewport">
      <div class="insta-carousel__container">
        {% for post in posts limit: post_limit %}
          {%- liquid
            assign media_url = post.media_url.value
            assign poster = post.thumbnail_url.value | default: media_url
            assign alt_text = post.caption.value | default: 'Instagram post' | strip_html | truncate: 80

            # The tagged products list doesn't answer `.first` (it comes back
            # empty), but it iterates fine, so take the first one with a loop.
            assign card_products = post.products.value
            assign card_product = nil
            for tagged_product in card_products limit: 1
              assign card_product = tagged_product
            endfor
          -%}
          <div
            class="insta-carousel__slide"
            role="group"
            aria-roledescription="slide"
            data-insta-card
            data-src="{{ media_url | escape }}"
            data-poster="{{ poster | escape }}"
            data-permalink="{{ post.permalink.value | escape }}"
            data-likes="{{ post.like_count.value }}"
            data-product-url="{{ card_product.url }}"
          >
            <div class="insta-carousel__media">
              <video
                class="insta-carousel__video"
                data-insta-video
                src="{{ media_url }}"
                poster="{{ poster }}"
                aria-label="{{ alt_text | escape }}"
                muted
                loop
                playsinline
                preload="none"
              ></video>

              <div class="insta-carousel__progress"><div class="insta-carousel__progress-bar" data-insta-progress></div></div>

              <button type="button" class="insta-carousel__mute" data-insta-mute aria-label="Unmute video">
                <svg class="insta-carousel__icon insta-carousel__icon--muted" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M12 4L9.91 6.09L12 8.18M4.27 3L3 4.27L7.73 9H3v6h4l5 5v-6.73l4.25 4.26c-.67.51-1.42.93-2.25 1.17v2.07c1.38-.32 2.63-.95 3.68-1.81L19.73 21L21 19.73l-9-9M19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.9 8.9 0 0 0 21 12c0-4.28-3-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71m-2.5 0c0-1.77-1-3.29-2.5-4.03v2.21l2.45 2.45c.05-.2.05-.42.05-.63"/>
                </svg>
                <svg class="insta-carousel__icon insta-carousel__icon--unmuted" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M3 9h4l5-5v16l-5-5H3V9zm18 3a9.003 9.003 0 0 1-7 8.777V18.71a7.003 7.003 0 0 0 0-13.42V3.223c4.008.91 7 4.494 7 8.777zm-4 0a5.001 5.001 0 0 1-3 4.584V7.416c1.766.772 3 2.534 3 4.584z"/>
                </svg>
              </button>

              {%- comment -%}
                The first tagged product, shown on hover. The rest are in the
                post dialog; "+N" says how many more there are.
              {%- endcomment -%}
              {% if card_product %}
                <div class="insta-carousel__product">
                  <a class="insta-carousel__product-link" href="{{ card_product.url }}" data-insta-product-link>
                    <span class="insta-carousel__product-image">
                      {% if card_product.featured_image %}
                        <img
                          src="{{ card_product.featured_image | image_url: width: 96 }}"
                          alt=""
                          width="32"
                          height="32"
                          loading="lazy"
                        >
                      {% endif %}
                    </span>
                    <span class="insta-carousel__product-info">
                      <span class="insta-carousel__product-title">{{ card_product.title | escape }}</span>
                      <span class="insta-carousel__product-price">
                        {%- if card_product.available -%}
                          {{- card_product.price | money -}}
                        {%- else -%}
                          Sold out
                        {%- endif -%}
                      </span>
                    </span>
                  </a>
                  {% if card_products.size > 1 %}
                    <span class="insta-carousel__product-more">+{{ card_products.size | minus: 1 }}</span>
                  {% endif %}
                  {% if card_product.available %}
                    <button
                      type="button"
                      class="insta-carousel__product-add"
                      data-insta-add-to-cart="{{ card_product.selected_or_first_available_variant.id }}"
                      aria-label="Add {{ card_product.title | escape }} to cart"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                    </button>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {%- comment -%}
              What the post dialog shows beside the video; carousel.js copies it
              in when this post is opened.
            {%- endcomment -%}
            <template data-insta-details>
              {% if post.caption.value != blank %}
                <button type="button" class="insta-dialog__caption" data-insta-caption>
                  {{- post.caption.value | escape | newline_to_br -}}
                </button>
              {% endif %}
              {%- assign tagged = post.products.value -%}
              {% if tagged.size > 0 %}
                <div class="insta-dialog__products">
                  <span class="insta-dialog__products-heading">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Shop this post
                    {% if tagged.size > 1 %}<span class="insta-dialog__products-count">({{ tagged.size }})</span>{% endif %}
                  </span>
                  <div class="insta-dialog__product-list">
                    {% for product in tagged %}
                      {%- comment -%}
                        A <div>, not an <a>: a button can't sit inside a link.
                        The title link is stretched over the whole card instead.
                      {%- endcomment -%}
                      <div class="insta-dialog__product">
                        <span class="insta-dialog__product-image">
                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 160 }}"
                              alt=""
                              width="56"
                              height="56"
                              loading="lazy"
                            >
                          {% endif %}
                        </span>
                        <span class="insta-dialog__product-info">
                          <a class="insta-dialog__product-title" href="{{ product.url }}">{{ product.title | escape }}</a>
                          {%- comment -%}
                            Live from Shopify: `price` is the cheapest variant,
                            hence "From" when variants differ.
                          {%- endcomment -%}
                          <span class="insta-dialog__product-price">
                            {%- if product.price_varies -%}
                              <span class="insta-dialog__product-from">From</span>
                            {%- endif -%}
                            <span class="insta-dialog__product-amount{% if product.compare_at_price > product.price %} is-sale{% endif %}">
                              {{- product.price | money -}}
                            </span>
                            {%- if product.compare_at_price > product.price -%}
                              <s>{{ product.compare_at_price | money }}</s>
                            {%- endif -%}
                            {%- unless product.available -%}
                              <span class="insta-dialog__product-soldout">Sold out</span>
                            {%- endunless -%}
                          </span>
                        </span>
                        {%- comment -%}
                          Straight to cart only when there's nothing to choose;
                          products with options go to their page via the card.
                        {%- endcomment -%}
                        {% if product.available %}
                          <button
                            type="button"
                            class="insta-dialog__product-add"
                            data-insta-add-to-cart="{{ product.selected_or_first_available_variant.id }}"
                            aria-label="Add {{ product.title | escape }} to cart"
                          >
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                          </button>
                        {% else %}
                          <svg class="insta-dialog__product-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </template>
          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Same as the app: auto-scrolling feeds have no arrows. {%- endcomment -%}
    {% unless cs_auto_scroll %}
    <button type="button" class="insta-carousel__btn insta-carousel__btn--prev" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span class="insta-carousel__sr">Previous slide</span>
    </button>
    <button type="button" class="insta-carousel__btn insta-carousel__btn--next" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"/>
      </svg>
      <span class="insta-carousel__sr">Next slide</span>
    </button>
    {% endunless %}

    {%- comment -%}
      Reels-style post viewer, styled after the app's shadcn Dialog
      (app/components/post-dialog.jsx). A native <dialog> opened with
      showModal() sits in the top layer, above any theme stacking context.
    {%- endcomment -%}
    {%- comment -%}
      Rendered for every action but "none": the Instagram and product actions
      fall back to it for posts with nowhere else to go.
    {%- endcomment -%}
    {% unless click_action == 'none' %}
    <dialog class="insta-dialog" data-insta-dialog aria-label="Instagram post">
      <div class="insta-dialog__layout">
        <div class="insta-dialog__info insta-dialog__info--side" data-insta-info>
          {% if ig_username != blank %}
            <a
              class="insta-dialog__account"
              href="https://www.instagram.com/{{ ig_username | url_encode }}/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="insta-dialog__avatar">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"/></svg>
                {%- comment -%}
                  Instagram's profile picture URL expires after a few days;
                  if it no longer loads, the logo badge underneath shows.
                {%- endcomment -%}
                {% if ig_avatar != blank %}
                  <img
                    class="insta-dialog__avatar-image"
                    src="{{ ig_avatar | escape }}"
                    alt=""
                    width="32"
                    height="32"
                    referrerpolicy="no-referrer"
                    loading="lazy"
                    onerror="this.remove()"
                  >
                {% endif %}
              </span>
              <span class="insta-dialog__username">{{ ig_username | escape }}</span>
            </a>
          {% endif %}
          <div class="insta-dialog__details" data-insta-details-slot></div>
        </div>

        {%- comment -%}
          Embla viewport: the track must stay its first child. carousel.js
          fills it with one slide per post and moves the single <video> into
          the current one.
        {%- endcomment -%}
        <div class="insta-dialog__stage" data-insta-dialog-stage>
          <div class="insta-dialog__track" data-insta-dialog-track></div>
          <video class="insta-dialog__video" data-insta-dialog-video loop playsinline></video>
          <span class="insta-dialog__play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 3.5v17a1 1 0 0 0 1.5.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 6 3.5"/></svg>
          </span>
          <button type="button" class="insta-dialog__mute" data-insta-dialog-mute aria-label="Mute video">
            <svg class="insta-carousel__icon insta-dialog__icon--muted" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M12 4L9.91 6.09L12 8.18M4.27 3L3 4.27L7.73 9H3v6h4l5 5v-6.73l4.25 4.26c-.67.51-1.42.93-2.25 1.17v2.07c1.38-.32 2.63-.95 3.68-1.81L19.73 21L21 19.73l-9-9M19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.9 8.9 0 0 0 21 12c0-4.28-3-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71m-2.5 0c0-1.77-1-3.29-2.5-4.03v2.21l2.45 2.45c.05-.2.05-.42.05-.63"/>
            </svg>
            <svg class="insta-carousel__icon insta-dialog__icon--unmuted" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M3 9h4l5-5v16l-5-5H3V9zm18 3a9.003 9.003 0 0 1-7 8.777V18.71a7.003 7.003 0 0 0 0-13.42V3.223c4.008.91 7 4.494 7 8.777zm-4 0a5.001 5.001 0 0 1-3 4.584V7.416c1.766.772 3 2.534 3 4.584z"/>
            </svg>
          </button>
          <div class="insta-dialog__progress"><div class="insta-dialog__progress-bar" data-insta-dialog-progress></div></div>
          <div class="insta-dialog__info insta-dialog__info--overlay" data-insta-info-overlay></div>
        </div>

        <div class="insta-dialog__actions">
          {%- comment -%} Display only; carousel.js fills and hides it per post. {%- endcomment -%}
          <div class="insta-dialog__action insta-dialog__likes" data-insta-dialog-likes hidden>
            <span class="insta-dialog__likes-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </span>
            <span class="insta-dialog__likes-count" data-insta-dialog-likes-count></span>
          </div>
          <a class="insta-dialog__action" data-insta-dialog-permalink target="_blank" rel="noopener" hidden>
            <span class="insta-dialog__round">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"/></svg>
            </span>
            <span class="insta-dialog__action-label">Instagram</span>
          </a>
          <button type="button" class="insta-dialog__action" data-insta-dialog-share>
            <span class="insta-dialog__round">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </span>
            <span class="insta-dialog__action-label">Share</span>
          </button>
        </div>
      </div>

      <div class="insta-dialog__nav">
        <button type="button" class="insta-dialog__round insta-dialog__round--lg" data-insta-dialog-prev aria-label="Previous post">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
        </button>
        <button type="button" class="insta-dialog__round insta-dialog__round--lg" data-insta-dialog-next aria-label="Next post">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>

      <button type="button" class="insta-dialog__round insta-dialog__close" data-insta-dialog-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </dialog>
    {% endunless %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Insta Carousel",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "feed",
      "label": "Feed label",
