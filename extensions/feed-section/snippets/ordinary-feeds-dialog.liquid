{%- comment -%}
  Reels-style post viewer every feed block opens on a post click (feed.js),
  styled after the app's shadcn Dialog (app/components/post-dialog.jsx). A
  native <dialog> opened with showModal() sits in the top layer, above any
  theme stacking context.

  Render it for every click action but "none": the Instagram and product
  actions fall back to it for posts with nowhere else to go.

  Params:
    ig_username, ig_avatar  the Instagram account shown beside the video
{%- endcomment -%}
<dialog class="ordinary-feeds-dialog" data-ordinary-feeds-dialog aria-label="Instagram post">
  <div class="ordinary-feeds-dialog__layout">
    <div class="ordinary-feeds-dialog__info ordinary-feeds-dialog__info--side" data-ordinary-feeds-info>
      {% if ig_username != blank %}
        <a
          class="ordinary-feeds-dialog__account"
          href="https://www.instagram.com/{{ ig_username | url_encode }}/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="ordinary-feeds-dialog__avatar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"/></svg>
            {%- comment -%}
              Instagram's profile picture URL expires after a few days;
              if it no longer loads, the logo badge underneath shows.
            {%- endcomment -%}
            {% if ig_avatar != blank %}
              <img
                class="ordinary-feeds-dialog__avatar-image"
                src="{{ ig_avatar | escape }}"
                alt=""
                width="32"
                height="32"
                referrerpolicy="no-referrer"
                loading="lazy"
                onerror="this.remove()"
              >
            {% endif %}
          </span>
          <span class="ordinary-feeds-dialog__username">{{ ig_username | escape }}</span>
        </a>
      {% endif %}
      <div class="ordinary-feeds-dialog__details" data-ordinary-feeds-details-slot></div>
    </div>

    {%- comment -%}
      Embla viewport: the track must stay its first child. feed.js
      fills it with one slide per post and moves the single <video> into
      the current one.
    {%- endcomment -%}
    <div class="ordinary-feeds-dialog__stage" data-ordinary-feeds-dialog-stage>
      <div class="ordinary-feeds-dialog__track" data-ordinary-feeds-dialog-track></div>
      <video class="ordinary-feeds-dialog__video" data-ordinary-feeds-dialog-video loop playsinline></video>
      <span class="ordinary-feeds-dialog__play" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 3.5v17a1 1 0 0 0 1.5.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 6 3.5"/></svg>
      </span>
      <button type="button" class="ordinary-feeds-dialog__mute" data-ordinary-feeds-dialog-mute aria-label="Mute video">
        <svg class="ordinary-feeds-card__icon ordinary-feeds-dialog__icon--muted" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 4L9.91 6.09L12 8.18M4.27 3L3 4.27L7.73 9H3v6h4l5 5v-6.73l4.25 4.26c-.67.51-1.42.93-2.25 1.17v2.07c1.38-.32 2.63-.95 3.68-1.81L19.73 21L21 19.73l-9-9M19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.9 8.9 0 0 0 21 12c0-4.28-3-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71m-2.5 0c0-1.77-1-3.29-2.5-4.03v2.21l2.45 2.45c.05-.2.05-.42.05-.63"/>
        </svg>
        <svg class="ordinary-feeds-card__icon ordinary-feeds-dialog__icon--unmuted" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M3 9h4l5-5v16l-5-5H3V9zm18 3a9.003 9.003 0 0 1-7 8.777V18.71a7.003 7.003 0 0 0 0-13.42V3.223c4.008.91 7 4.494 7 8.777zm-4 0a5.001 5.001 0 0 1-3 4.584V7.416c1.766.772 3 2.534 3 4.584z"/>
        </svg>
      </button>
      <div class="ordinary-feeds-dialog__progress"><div class="ordinary-feeds-dialog__progress-bar" data-ordinary-feeds-dialog-progress></div></div>
      <div class="ordinary-feeds-dialog__info ordinary-feeds-dialog__info--overlay" data-ordinary-feeds-info-overlay></div>
    </div>

    <div class="ordinary-feeds-dialog__actions">
      {%- comment -%} Display only; feed.js fills and hides it per post. {%- endcomment -%}
      <div class="ordinary-feeds-dialog__action ordinary-feeds-dialog__likes" data-ordinary-feeds-dialog-likes hidden>
        <span class="ordinary-feeds-dialog__likes-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </span>
        <span class="ordinary-feeds-dialog__likes-count" data-ordinary-feeds-dialog-likes-count></span>
      </div>
      <a class="ordinary-feeds-dialog__action" data-ordinary-feeds-dialog-permalink target="_blank" rel="noopener" hidden>
        <span class="ordinary-feeds-dialog__round">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"/></svg>
        </span>
        <span class="ordinary-feeds-dialog__action-label">Instagram</span>
      </a>
      <button type="button" class="ordinary-feeds-dialog__action" data-ordinary-feeds-dialog-share>
        <span class="ordinary-feeds-dialog__round">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </span>
        <span class="ordinary-feeds-dialog__action-label">Share</span>
      </button>
    </div>
  </div>

  <div class="ordinary-feeds-dialog__nav">
    <button type="button" class="ordinary-feeds-dialog__round ordinary-feeds-dialog__round--lg" data-ordinary-feeds-dialog-prev aria-label="Previous post">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <button type="button" class="ordinary-feeds-dialog__round ordinary-feeds-dialog__round--lg" data-ordinary-feeds-dialog-next aria-label="Next post">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>

  <button type="button" class="ordinary-feeds-dialog__round ordinary-feeds-dialog__close" data-ordinary-feeds-dialog-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</dialog>
